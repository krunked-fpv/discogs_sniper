# Discogs Sniper Environment Configuration Template
# Recommended: store real secrets ONLY in Windows User Environment Variables
# (HKCU\Environment) rather than plaintext files:
#   [Environment]::SetEnvironmentVariable("DISCOGS_TOKEN", "<token>", "User")
#   [Environment]::SetEnvironmentVariable("GMAIL_APP_PASSWORD", "<16-char-pw>", "User")
#
# Copy this file to `.env` (gitignored and blocked by git hooks) if you need
# local non-secret overrides. NEVER commit `.env` or real credentials.

DISCOGS_USERNAME=your_discogs_username
DISCOGS_TOKEN=$env:DISCOGS_TOKEN

# Gmail SMTP High-Priority Alert Credentials (resolved from Windows env var)
EMAIL_ADDRESS=your_email@gmail.com
CC_EMAIL_ADDRESS=
GMAIL_APP_PASSWORD=$env:GMAIL_APP_PASSWORD

# Optional ntfy.sh Urgent Mobile Push Topic
NTFY_BASE=https://ntfy.sh
NTFY_TOPIC=
