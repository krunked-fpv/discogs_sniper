# Local secrets & environment overrides (NEVER commit .env files to git)
.env
.env.*
*.env
!.env.example

# Private keys, certificates & credential files
*.pem
*.key
*.p12
*.pfx
*.jks
credentials.json
token.json

# Backup & cookie backup files
*.bak
*.cookie_bak

# Persistent Playwright browser profile & runtime state
chrome_discogs_profile/
sniper.log
sniper.lock

# Temporary debug snapshots
debug_*.png
debug_*.html

# Staged GitHub Pages artifact directory
_site/

# Python bytecode, test caches & virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/

# Local-only notes & tooling artifacts
*.md
!README.md
dna/
export-dna.ts
