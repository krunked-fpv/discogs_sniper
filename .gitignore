# Local overrides (optional untracked file; .env is tracked with $env:DISCOGS_TOKEN auto-hydration)
.env.local

# Persistent Playwright browser profile & runtime state
chrome_discogs_profile/
sniper.log
sniper.lock

# Temporary debug snapshots
debug_*.png
debug_*.html

# Python bytecode & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
